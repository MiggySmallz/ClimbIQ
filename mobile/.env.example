# Copy to mobile/.env and fill in from the Supabase dashboard (Project Settings → API).
# These are the PUBLIC client values (spec §13) — the service-role key never goes here.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# ClimbIQ orchestrator base URL (the Fastify service, spec §7.2). For local dev
# on a device, use your machine's LAN IP (e.g. http://192.168.1.10:8080), not
# localhost. In production, the deployed orchestrator URL (M3.11).
EXPO_PUBLIC_API_URL=http://localhost:8080
