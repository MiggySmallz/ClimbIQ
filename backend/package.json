{
  "name": "@climbiq/backend",
  "version": "0.1.0",
  "private": true,
  "description": "ClimbIQ orchestrator service (Fastify) — presigned URLs, Nosana jobs, report ingestion, push notifications.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "tsx --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node --import tsx --test src/nosana/jobDefinition.test.ts src/r2/client.test.ts",
    "db:push": "supabase db push",
    "db:reset": "supabase db reset",
    "db:new": "supabase migration new"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1091.0",
    "@aws-sdk/s3-request-presigner": "^3.1091.0",
    "@climbiq/shared": "*",
    "@nosana/kit": "^2.7.0",
    "@supabase/supabase-js": "^2.110.3",
    "ajv": "^8.20.0",
    "fastify": "^5.7.4",
    "fastify-plugin": "^5.1.0",
    "expo": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "~5.8.3"
  },
  "engines": {
    "node": ">=20.18"
  }
}
