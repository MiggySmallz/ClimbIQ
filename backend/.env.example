# ClimbIQ orchestrator — copy to .env and fill in (never commit .env).
# All config is env-only (spec §13); missing required vars fail startup.

# Required
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (S3-compatible) — presigned upload/download URLs (spec §8.2, §9).
# Endpoint is derived: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com (region "auto").
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Nosana job posting (spec §8.2) — required once analysis jobs are posted (M3.5+).
# Loaded lazily (loadNosanaConfig), so the server still boots without these.
NOSANA_API_KEY=nos_...
NOSANA_MARKET=            # pinned GPU market address (§8.1 warm-node strategy)
ANALYSIS_IMAGE=          # published analysis image ref, e.g. registry/climbiq-analysis:<tag> (M3.12)

# Optional
PORT=8080
LOG_LEVEL=info
# Project owner's Supabase user id — unlocks the owner-only cost summary at
# GET /admin/usage (spec §8.3, M6.2). Leave unset to disable that endpoint.
OWNER_USER_ID=
# Low-Credits alert threshold in USD (M6.3): the owner's in-app admin card flags
# the balance as "low" when spendable Credits fall below this. Default 5.
NOSANA_CREDITS_ALERT_USD=5
NOSANA_JOB_TIMEOUT_S=2700
# Pose sample rate baked into JOB_PARAMS. 30 = smooth overlay + fine temporal
# detail for dynamic moves, at ~10x the pose GPU time (and cost) of 3.
ANALYSIS_SAMPLE_FPS=30
# Optional: pin jobs to a specific node ADDRESS within NOSANA_MARKET (dev warm-
# node). The node must be staked + running in that market. Unset = market-wide
# assignment (normal). NOSANA_MARKET is still required either way.
NOSANA_NODE=
