{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://climbiq.app/schema/error.schema.json",
  "title": "AnalysisErrorResult",
  "description": "Structured error JSON PUT to RESULT_PUT_URL on job failure. Mirrors shared/src/report.ts AnalysisErrorResult — keep in sync.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "video_id", "error"],
  "properties": {
    "version": { "const": 1 },
    "video_id": { "type": "string", "minLength": 1 },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "message"],
      "properties": {
        "stage": {
          "enum": ["download", "pose", "features", "llm", "render", "upload", "unknown"]
        },
        "message": { "type": "string", "minLength": 1 }
      }
    }
  }
}
